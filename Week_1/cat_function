#include<cs50.h>
#include<stdio.h>

// Creating function to print meow n number of times

void meow(int n)
{
    for (int i = 0; i < n; i++)
    {
        printf("Meow\n");
    }
}

// Main function to get the input value from the user

int main()
{
    int n;
    do
    {
        n = get_int("Enter the value of n: ");
    }while(n < 0);
    meow(n);
}
